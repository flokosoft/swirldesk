{
  "logo": {
    "type": "file",
    "source": "~/.config/swirldesk/themes/swirldesk-matrix/session/logo.txt",
    "color": {
      "1": "green"
    },
    "padding": {
      "right": 3
    }
  },
  "display": {
    "separator": " : ",
    "color": {
      "keys": "green",
      "title": "light_green"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "separator"
    },
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "kernel",
      "key": "KERNEL"
    },
    {
      "type": "wm",
      "key": "WM"
    },
    {
      "type": "terminal",
      "key": "TERMINAL"
    },
    {
      "type": "shell",
      "key": "SHELL"
    },
    {
      "type": "cpu",
      "key": "CPU"
    },
    {
      "type": "gpu",
      "key": "GPU"
    },
    {
      "type": "memory",
      "key": "RAM"
    },
    {
      "type": "disk",
      "key": "DISK"
    },
    {
      "type": "battery",
      "key": "BATTERY"
    },
    {
      "type": "uptime",
      "key": "UPTIME"
    }
  ]
}
