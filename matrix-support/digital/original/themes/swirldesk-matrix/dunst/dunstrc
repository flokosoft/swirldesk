# SwirlDesk MATRIX // Dunst v0.8
# MATRIX operator notifications. No application icons.

[global]
    monitor = 0
    follow = mouse

    width = 356
    height = 118
    origin = top-right
    offset = 8x38
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 3
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 0

    indicate_hidden = true
    transparency = 0
    separator_height = 0
    gap_size = 3
    padding = 9
    horizontal_padding = 11
    text_icon_padding = 0

    frame_width = 1
    frame_color = "#00b950"
    separator_color = frame

    background = "#050805"
    foreground = "#b4dcc1"
    highlight = "#00ff65"

    sort = true
    idle_threshold = 120

    font = JetBrainsMono Nerd Font 10
    line_height = 1

    markup = full
    format = "<span foreground='#00b950'><b>INCOMING //</b></span> <b>%s</b>\n<span foreground='#78a58a'>%b</span>"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle

    icon_position = off
    sticky_history = true
    history_length = 20

    corner_radius = 0

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#050805"
    foreground = "#78a58a"
    frame_color = "#254b33"
    highlight = "#38734e"
    timeout = 4

[urgency_normal]
    background = "#050805"
    foreground = "#b4dcc1"
    frame_color = "#00b950"
    highlight = "#00ff65"
    timeout = 6

[urgency_critical]
    background = "#050805"
    foreground = "#b4dcc1"
    frame_color = "#d76e64"
    highlight = "#d8bc70"
    timeout = 0
