{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 0,
  "modules-left": [
    "custom/matrix",
    "custom/matrix-profile",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "network",
    "custom/wireguard",
    "pulseaudio",
    "custom/battery",
    "custom/notifications",
    "clock",
    "tray",
    "custom/exit"
  ],
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}"
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 36,
    "separate-outputs": true
  },
  "cpu": {
    "format": "CPU {usage}%",
    "interval": 2,
    "tooltip": true,
    "tooltip-format": "CPU-Auslastung: {usage}%",
    "on-click": "bash ~/.config/swirldesk/themes/swirldesk-matrix/control/open.sh",
    "on-click-right": "kitty --class btop-floating -e btop"
  },
  "memory": {
    "format": "MEM {percentage}%",
    "interval": 2,
    "tooltip": true,
    "tooltip-format": "RAM-Auslastung: {used:0.1f}G / {total:0.1f}G",
    "on-click": "bash ~/.config/swirldesk/themes/swirldesk-matrix/control/open.sh",
    "on-click-right": "kitty --class btop-floating -e btop"
  },
  "network": {
    "interval": 2,
    "format-wifi": "LINK {signalStrength}%",
    "format-ethernet": "LINK LAN",
    "format-disconnected": "OFFLINE",
    "tooltip-format": "{ifname}\nIP: {ipaddr}\nDown: {bandwidthDownBits}\nUp: {bandwidthUpBits}",
    "on-click": "nm-connection-editor"
  },
  "custom/wireguard": {
    "exec": "~/.config/swirldesk/scripts/wg-status.sh",
    "return-type": "json",
    "interval": 5,
    "on-click": "~/.config/swirldesk/scripts/wireguard-toggle.sh"
  },
  "pulseaudio": {
    "format": "AUD {volume}%",
    "format-muted": "AUD --",
    "format-icons": {
      "headphone": "",
      "headset": "󰋎",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol"
  },
  "custom/battery": {
    "exec": "~/.config/swirldesk/scripts/battery-waybar.sh",
    "return-type": "json",
    "interval": 10,
    "tooltip": true
  },
  "clock": {
    "format": "T {:%H:%M}",
    "tooltip-format": "<big>{:%A, %d. %B %Y}</big>"
  },
  "custom/notifications": {
    "exec": "~/.config/swirldesk/scripts/notification-status.sh",
    "return-type": "json",
    "interval": 2,
    "on-click": "~/.config/swirldesk/scripts/toggle-notifications.sh",
    "tooltip": true
  },
  "tray": {
    "icon-size": 14,
    "spacing": 6,
    "icons": {
      "signal": "$HOME/.config/swirldesk/themes/swirldesk-matrix/icons/SwirlDesk-MATRIX/scalable/apps/matrix-chat.svg",
      "Signal": "$HOME/.config/swirldesk/themes/swirldesk-matrix/icons/SwirlDesk-MATRIX/scalable/apps/matrix-chat.svg",
      "signal-desktop": "$HOME/.config/swirldesk/themes/swirldesk-matrix/icons/SwirlDesk-MATRIX/scalable/apps/matrix-chat.svg",
      "org.signal.Signal": "$HOME/.config/swirldesk/themes/swirldesk-matrix/icons/SwirlDesk-MATRIX/scalable/apps/matrix-chat.svg",
      "bitwarden": "$HOME/.config/swirldesk/themes/swirldesk-matrix/icons/SwirlDesk-MATRIX/scalable/apps/matrix-vault.svg",
      "Bitwarden": "$HOME/.config/swirldesk/themes/swirldesk-matrix/icons/SwirlDesk-MATRIX/scalable/apps/matrix-vault.svg",
      "com.bitwarden.desktop": "$HOME/.config/swirldesk/themes/swirldesk-matrix/icons/SwirlDesk-MATRIX/scalable/apps/matrix-vault.svg",
      "nextcloud": "$HOME/.config/swirldesk/themes/swirldesk-matrix/icons/SwirlDesk-MATRIX/scalable/apps/matrix-cloud.svg",
      "Nextcloud": "$HOME/.config/swirldesk/themes/swirldesk-matrix/icons/SwirlDesk-MATRIX/scalable/apps/matrix-cloud.svg",
      "com.nextcloud.desktopclient.nextcloud": "$HOME/.config/swirldesk/themes/swirldesk-matrix/icons/SwirlDesk-MATRIX/scalable/apps/matrix-cloud.svg"
    }
  },
  "custom/exit": {
    "format": "",
    "tooltip": false,
    "on-click": "~/.config/swirldesk/scripts/power-menu.sh"
  },
  "custom/matrix": {
    "format": "MATRIX //",
    "tooltip": true,
    "tooltip-format": "MATRIX // Operator environment\nClick: Control Center\nRight click: Theme switcher\nMiddle click: System information",
    "on-click": "bash ~/.config/swirldesk/themes/swirldesk-matrix/control/open.sh",
    "on-click-right": "~/.config/swirldesk/scripts/theme-switcher.sh",
    "on-click-middle": "~/.config/swirldesk/scripts/system-info.sh"
  },
  "custom/matrix-profile": {
    "exec": "~/.config/swirldesk/themes/swirldesk-matrix/visual/profile.sh --status",
    "interval": 3,
    "format": "VIS {}",
    "tooltip": true,
    "tooltip-format": "MATRIX // Visual profile\nClick: select profile",
    "on-click": "~/.config/swirldesk/themes/swirldesk-matrix/visual/profile.sh"
  }
}
